{
  "name": "gymclip-reviewer",
  "private": true,
  "version": "1.2.1",
  "description": "Desktop reviewer for gymnastics competition video candidate clips.",
  "author": "Cris Hu",
  "engines": {
    "node": ">=22 <26",
    "npm": ">=11 <12"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:backend": "node electron/scripts/build-backend.cjs",
    "build:media-tools": "node electron/scripts/build-media-tools.cjs",
    "build:oss-tools": "node electron/scripts/build-oss-tools.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"npm run dev:web\" \"wait-on tcp:3000 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron .\"",
    "electron:dir": "npm run build:web && npm run build:backend && npm run build:media-tools && npm run build:oss-tools && electron-builder --dir",
    "electron:pack": "npm run build:web && npm run build:backend && npm run build:media-tools && npm run build:oss-tools && electron-builder",
    "electron:pack:cleanroom": "node electron/scripts/pack-mac-cleanroom.cjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.13.0",
    "@sentry/react": "^10.54.0",
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^5.1.4",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^6.4.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@types/node": "^22.19.15",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.cris-hu.gymclip-reviewer",
    "productName": "GymClip Reviewer",
    "directories": {
      "output": "electron-dist"
    },
    "afterPack": "electron/scripts/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/standalone",
        "to": "backend-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist/media-tools",
        "to": "media-tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist/oss-tools",
        "to": "oss-tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
