node_modules/
# Ignore everything under build/ (Vite/tsc output, electron-builder staging),
# but keep tracked signing resources (entitlements plist, icons) committed.
build/*
!build/entitlements.mac.plist
!build/icon.icns
!build/icon.png
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Playwright
test-results/
playwright-report/
playwright/.cache/

# E2E synthetic fixture videos (regenerable via e2e/fixtures/generate.sh)
e2e/fixtures/*.mp4
