# Sentry DSNs (registered at https://sentry.io)
# Each end is a separate Sentry project:
#   - gymclip-frontend   → React renderer
#   - gymclip-electron   → Electron main process
#   - gymclip-backend    → FastAPI Python backend
#
# Copy this file to .env.local (frontend) / .env (backend) and fill in real DSNs.
# .env.local and .env are gitignored.

# Frontend (React renderer, loaded via Vite import.meta.env)
VITE_SENTRY_DSN_FRONTEND=

# Electron main process (loaded via process.env in main.cjs)
SENTRY_DSN_ELECTRON=

# FastAPI backend (loaded via os.getenv in backend/main.py)
SENTRY_DSN_BACKEND=

# Sentry release info — Electron main + Python backend read these.
# Auto-injected by CI release.yml in production builds; optional in dev.
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=development

# Same release info exposed to the Vite-bundled renderer (must keep
# VITE_ prefix so Vite ships it to the browser bundle).
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=development

# Source map upload — only used at build time on CI release jobs.
# When all three are set, vite.config.ts enables @sentry/vite-plugin which
# generates hidden source maps and uploads them. Locally / in dev these stay
# empty and the plugin no-ops (zero overhead).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_FRONTEND=gymclip-frontend
SENTRY_PROJECT_ELECTRON=gymclip-electron
SENTRY_PROJECT_BACKEND=gymclip-backend
